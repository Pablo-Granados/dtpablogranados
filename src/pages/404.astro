---
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
---

<Base title="Página no encontrada" noindex>
  <section class="page py-32">
    <p class="tag text-signal">404 · Fuera de juego</p>
    <h1 class="display mt-4 text-6xl text-bone md:text-8xl">Esta jugada no existe</h1>
    <p class="mt-6 max-w-lg text-lg text-mute">La página que buscás no está, o todavía la estoy construyendo.</p>
    <div class="mt-10"><Button href="/">Volver al inicio</Button></div>
  </section>
</Base>
