---
import Base from '@/layouts/Base.astro';
import TemplateForm from '@/components/TemplateForm.astro';
import { templates } from '@/data/plantillas';

export function getStaticPaths() {
  return templates.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}

const { t } = Astro.props;
const others = templates.filter((x) => x.slug !== t.slug);
---

<Base title={`${t.name} · plantilla gratuita`} description={`${t.tagline}. ${t.summary}`}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="court-grid pointer-events-none absolute inset-0 opacity-30" aria-hidden="true"></div>
    <div class="page relative py-16 md:py-24">
      <a href="/plantillas" class="tag text-faint hover:text-bone">← Todas las plantillas</a>
      <p class="tag mt-8 text-signal">Plantilla {t.n} · Gratis · PDF y hoja de cálculo</p>
      <h1 class="display mt-5 max-w-4xl text-5xl text-bone sm:text-6xl lg:text-7xl">{t.name}</h1>
      <p class="mt-6 max-w-2xl text-xl leading-relaxed text-mute">{t.tagline}. {t.summary}</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="page grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <h2 class="display text-3xl text-bone md:text-4xl">Qué trae</h2>
        <ul class="mt-6 space-y-3">
          {
            t.items.map((it) => (
              <li class="flex gap-3 text-bone">
                <span class="mt-2.5 h-px w-3 shrink-0 bg-signal" aria-hidden="true" />
                <span class="leading-relaxed">{it}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 text-sm leading-relaxed text-faint">
          Escrita con ejemplos de futsal. Sirve para fútbol: cambian las estructuras, no las preguntas.
        </p>
      </div>

      <div class="lg:col-span-6">
        <div class="frame border border-line bg-panel p-6 md:p-8">
          <h2 class="text-xl font-semibold text-bone">Dejá tu mail y descargala</h2>
          <p class="mt-2 mb-6 text-sm leading-relaxed text-mute">Te llegan los archivos por mail y los podés bajar acá mismo.</p>
          <TemplateForm slug={t.slug} submitLabel="Descargar gratis" place={`plantilla-${t.slug}`} />
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line py-16 md:py-20">
    <div class="page">
      <p class="tag text-faint">Las otras plantillas</p>
      <ul class="mt-6 border-b border-line">
        {
          others.map((o) => (
            <li class="border-t border-line">
              <a href={`/plantillas/${o.slug}`} class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 text-bone transition-colors hover:text-signal">
                <span>
                  <span class="tag mr-3 text-faint">{o.n}</span>
                  {o.name}
                </span>
                <span class="text-sm text-mute group-hover:text-signal">{o.tagline}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
