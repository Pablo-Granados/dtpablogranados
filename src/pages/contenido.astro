---
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import YouTube from '@/components/ui/YouTube.astro';
import { analysis, mostViewed, channel } from '@/data/contenido';
import { cta } from '@/data/site';
---

<Base
  title="Contenido: análisis y resúmenes de futsal"
  description="Análisis de jugadas y situaciones de futsal, y los resúmenes de la AFA que miles de personas ven. Canal de Pablo Granados."
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="court-grid pointer-events-none absolute inset-0 opacity-30" aria-hidden="true"></div>
    <div class="page relative py-16 md:py-24" data-reveal>
      <p class="tag reveal text-signal">Contenido</p>
      <h1 class="display reveal mt-6 max-w-4xl text-5xl text-bone sm:text-7xl lg:text-8xl" style="--d:.06s">
        Lo que miro y lo que se ve
      </h1>
      <p class="reveal mt-6 max-w-2xl text-xl leading-relaxed text-mute" style="--d:.12s">
        Dos tipos de videos: análisis de jugadas y situaciones del futsal, y los resúmenes de la AFA que miles de personas
        ven cada semana.
      </p>
      <div class="reveal mt-9 flex flex-wrap items-center gap-x-6 gap-y-4" style="--d:.18s">
        <Button href={cta.youtube.href} event={cta.youtube.event} place="contenido-cabecera">{cta.youtube.label}</Button>
        <Button href={channel.playlists} variant="text" event="out_youtube_playlists" place="contenido-cabecera">Ver las listas del canal</Button>
      </div>
    </div>
  </section>

  <!-- Análisis -->
  <section class="py-16 md:py-24" aria-labelledby="analisis-title">
    <div class="page">
      <div class="mb-10 max-w-2xl" data-reveal>
        <h2 id="analisis-title" class="display reveal text-4xl text-bone md:text-5xl">Análisis</h2>
        <p class="reveal mt-4 text-lg leading-relaxed text-mute" style="--d:.08s">
          Situaciones concretas explicadas en pocos minutos: qué pasa, por qué pasa y qué se puede hacer con eso.
        </p>
      </div>
      <ul class="grid gap-8 md:grid-cols-3" data-reveal>
        {
          analysis.map((v, i) => (
            <li class="reveal" style={`--d:${i * 0.08}s`}>
              <YouTube id={v.id} title={v.title} />
              <p class="tag mt-4 text-signal">{v.note}</p>
              <h3 class="mt-2 text-lg font-medium leading-snug text-bone">{v.title}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Lo más visto -->
  <section class="border-t border-line bg-panel py-16 md:py-24" aria-labelledby="visto-title">
    <div class="page">
      <div class="mb-10 max-w-2xl" data-reveal>
        <h2 id="visto-title" class="display reveal text-4xl text-bone md:text-5xl">Lo más visto</h2>
        <p class="reveal mt-4 text-lg leading-relaxed text-mute" style="--d:.08s">
          Los resúmenes de partidos de la AFA, de mayor a menor audiencia. Son los videos que traen a la gente al canal.
        </p>
      </div>
      <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3" data-reveal>
        {
          mostViewed.map((v, i) => (
            <li class="reveal" style={`--d:${(i % 3) * 0.08}s`}>
              <YouTube id={v.id} title={v.title} />
              <p class="tag mt-4 text-signal">{v.note}</p>
              <h3 class="mt-2 text-base font-medium leading-snug text-bone">{v.title}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Listas -->
  <section class="py-16 md:py-24" aria-labelledby="listas-title">
    <div class="page grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="listas-title" class="display reveal text-4xl text-bone md:text-5xl">Las listas del canal</h2>
        <p class="reveal mt-4 text-lg leading-relaxed text-mute" style="--d:.08s">
          Para ver torneos completos o temas puntuales de corrido.
        </p>
        <div class="reveal mt-8" style="--d:.16s">
          <Button href={channel.playlists} variant="ghost" event="out_youtube_playlists" place="contenido-listas">Abrir en YouTube</Button>
        </div>
      </div>
      <ul class="border-b border-line lg:col-span-7" data-reveal>
        {
          channel.lists.map((l, i) => (
            <li class="reveal border-t border-line py-4 text-lg text-bone" style={`--d:${i * 0.05}s`}>{l}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cierre -->
  <section class="border-t border-line">
    <div class="page flex flex-col items-start gap-8 py-20 md:flex-row md:items-end md:justify-between md:py-24">
      <div class="max-w-2xl">
        <h2 class="display text-5xl text-bone md:text-6xl">¿Querés que analice tu clip?</h2>
        <p class="mt-4 text-lg leading-relaxed text-mute">
          Cada mes elijo clips de equipos para analizarlos de manera pública. Es gratis, por cupo.
        </p>
      </div>
      <Button href="/clip" event="cta_clip" place="contenido-cierre">Mandar un clip</Button>
    </div>
  </section>
</Base>
