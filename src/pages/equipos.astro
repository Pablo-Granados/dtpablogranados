---
import Base from '@/layouts/Base.astro';
import { options } from '@/data/equipos';

const input =
  'w-full border border-line-strong bg-ink px-3 py-3 text-base text-bone placeholder:text-faint focus:border-signal focus:outline-none';
const chip =
  'cursor-pointer border border-line-strong px-4 py-2.5 text-sm text-mute transition-colors hover:border-signal hover:text-bone has-[:checked]:border-signal has-[:checked]:bg-signal/10 has-[:checked]:text-bone has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-signal';

const groups = [
  ['rol', '¿Cuál es tu rol?', options.rol],
  ['deporte', '¿En qué deporte?', options.deporte],
  ['nivel', '¿En qué nivel?', options.nivel],
] as const;
---

<Base
  title="Consulta para clubes y agencias"
  description="Contame qué necesita tu equipo u organización: informes de rival, acompañamiento durante la temporada o una herramienta a medida."
  noindex
>
  <section class="page max-w-3xl py-14 md:py-20">
    <a href="/trabajar-juntos#equipos" class="tag text-faint hover:text-bone">← Para clubes y agencias</a>
    <h1 class="display mt-4 text-5xl text-bone md:text-6xl">Contame qué necesitás</h1>
    <p class="mt-4 text-lg leading-relaxed text-mute">
      Cuanto más concreto seas, mejor llego a la primera respuesta. La leo yo y te contesto dentro de las 24 horas, con
      preguntas o con una propuesta.
    </p>

    <form data-team class="mt-10 grid gap-8" novalidate>
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="grid gap-2 text-sm text-mute">Nombre y apellido
          <input name="nombre" required maxlength="80" autocomplete="name" class={input} />
        </label>
        <label class="grid gap-2 text-sm text-mute">Email
          <input name="email" type="email" required maxlength="160" autocomplete="email" class={input} />
        </label>
        <label class="grid gap-2 text-sm text-mute">Club u organización
          <input name="organizacion" required maxlength="120" autocomplete="organization" class={input} />
        </label>
        <label class="grid gap-2 text-sm text-mute">WhatsApp <span class="text-faint">(opcional, con código de país)</span>
          <input name="whatsapp" type="tel" maxlength="40" autocomplete="tel" placeholder="+54 9 341 …" class={input} />
        </label>
      </div>

      <div role="radiogroup" aria-label="¿Qué necesitás?" class="grid gap-3">
        <p class="text-sm text-mute">¿Qué necesitás?</p>
        <div class="flex flex-wrap gap-2">
          {
            options.necesidad.map((o) => (
              <label class={chip}>
                <input type="radio" name="necesidad" value={o.label} data-id={o.id} required class="sr-only" />
                {o.label}
              </label>
            ))
          }
        </div>
      </div>

      {
        groups.map(([name, label, list]) => (
          <div role="radiogroup" aria-label={label} class="grid gap-3">
            <p class="text-sm text-mute">{label}</p>
            <div class="flex flex-wrap gap-2">
              {list.map((o) => (
                <label class={chip}>
                  <input type="radio" name={name} value={o} required class="sr-only" />
                  {o}
                </label>
              ))}
            </div>
          </div>
        ))
      }

      <label class="grid gap-2 text-sm text-mute">
        Contame el contexto
        <textarea name="contexto" required minlength="10" maxlength="1500" rows="5"
          placeholder="Por ejemplo: categoría, cuántos partidos por semana, cómo analizan hoy, qué decisión quieren mejorar o qué herramienta les falta."
          class={input}></textarea>
      </label>

      <input name="web" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
        <p data-msg class="text-sm text-signal" role="status"></p>
        <button type="submit" class="inline-flex items-center gap-2 bg-signal px-6 py-3.5 font-semibold text-ink transition-colors hover:bg-bone disabled:opacity-60">
          Enviar consulta
        </button>
      </div>
    </form>

    <div data-done hidden class="mt-12 border-t border-line pt-10">
      <p class="tag text-signal">Consulta recibida</p>
      <h2 class="display mt-3 text-4xl text-bone md:text-5xl">Gracias por contarme</h2>
      <p class="mt-4 text-lg leading-relaxed text-mute">
        Te mandé un mail de confirmación. Te respondo personalmente dentro de las 24 horas. Si no lo ves, revisá la
        carpeta de spam.
      </p>
      <a href="/trabajar-juntos" class="mt-8 inline-block text-sm text-mute underline underline-offset-4 hover:text-signal">Volver a las opciones</a>
    </div>
  </section>
</Base>

<script>
  import { startSending } from '@/scripts/sending';

  type Umami = { track: (event: string, data?: Record<string, unknown>) => void };
  const track = (e: string, d?: Record<string, unknown>) => (window as unknown as { umami?: Umami }).umami?.track(e, d);

  const form = document.querySelector<HTMLFormElement>('[data-team]')!;
  const msg = form.querySelector<HTMLElement>('[data-msg]')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  // Preselecciona la necesidad si viene de una oferta: /equipos?necesidad=informes
  const wanted = new URLSearchParams(location.search).get('necesidad');
  if (wanted) form.querySelector<HTMLInputElement>(`input[name="necesidad"][data-id="${CSS.escape(wanted)}"]`)?.click();

  let started = false;
  form.addEventListener('input', () => {
    if (!started) { started = true; track('equipos_start'); }
  });

  /** Devuelve el primer campo obligatorio que falta, o null si está todo. */
  function firstMissing(): HTMLElement | null {
    for (const el of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required]:not([type=radio]), textarea[required]')) {
      if (!el.checkValidity()) return el;
    }
    const names = new Set([...form.querySelectorAll<HTMLInputElement>('input[type=radio][required]')].map((r) => r.name));
    for (const name of names) {
      if (!form.querySelector(`input[name="${name}"]:checked`)) return form.querySelector<HTMLElement>(`input[name="${name}"]`)?.closest('[role=radiogroup]') as HTMLElement;
    }
    return null;
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const missing = firstMissing();
    if (missing) {
      const name = (missing as HTMLInputElement).name;
      msg.className = 'text-sm text-signal';
      msg.textContent = name === 'email' ? 'Revisá el email.' : name === 'contexto' ? 'Contame un poco más para poder ayudarte.' : 'Te falta completar algún campo.';
      missing.scrollIntoView({ block: 'center', behavior: 'smooth' });
      (missing.matches('input,textarea') ? missing : missing.querySelector<HTMLElement>('input'))?.focus({ preventScroll: true });
      return;
    }

    const data: Record<string, unknown> = Object.fromEntries(new FormData(form));
    data.utm = Object.fromEntries([...new URLSearchParams(location.search)].filter(([k]) => k.startsWith('utm_')));

    const stopSending = startSending(submit, msg);

    try {
      const res = await fetch('/api/equipos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(await res.text());
      track('equipos_submit', { necesidad: String(data.necesidad) });
      form.hidden = true;
      document.querySelector<HTMLElement>('[data-done]')!.hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch {
      stopSending();
      msg.className = 'text-sm text-signal';
      msg.textContent = 'No se pudo enviar. Probá de nuevo en un rato.';
    }
  });
</script>
