---
import Button from '@/components/ui/Button.astro';
import { chapters } from '@/data/ofertas';

/** Resumen de la escalera: sale de los mismos datos que la página "Trabajar juntos". */
---

<section id="caminos" class="border-b border-line py-20 md:py-28" aria-labelledby="caminos-title">
  <div class="page">
    <header class="mb-12 grid gap-6 lg:grid-cols-12" data-reveal>
      <h2 id="caminos-title" class="display reveal text-[2.5rem] text-bone sm:text-5xl md:text-6xl lg:col-span-7">
        Tres formas de trabajar juntos
      </h2>
      <p class="reveal text-lg leading-relaxed text-mute lg:col-span-5 lg:pt-2" style="--d:.08s">
        Empezás por lo que necesitás hoy. Cada camino tiene su precio publicado, y los que dependen del alcance se
        cotizan con una consulta.
      </p>
    </header>

    <ul class="border-b border-line">
      {
        chapters.map((c, i) => (
          <li class="reveal grid gap-6 border-t border-line py-9 lg:grid-cols-12 lg:gap-10" data-reveal style={`--d:${i * 0.06}s`}>
            <p class="tag text-faint lg:col-span-1">{c.n}</p>
            <div class="lg:col-span-4">
              <h3 class="text-2xl font-semibold leading-tight text-bone md:text-3xl">{c.title}</h3>
              <p class="mt-3 leading-relaxed text-mute">{c.lead}</p>
            </div>
            <ul class="lg:col-span-5">
              {
                c.offers.map((o) => (
                  <li class="flex items-baseline justify-between gap-6 border-b border-line py-3 first:pt-0 last:border-b-0">
                    <span class="text-bone">{o.name}</span>
                    <span class="shrink-0 font-mono text-sm text-signal">{o.price}</span>
                  </li>
                ))
              }
            </ul>
            <div class="lg:col-span-2 lg:text-right">
              <Button
                href={`/trabajar-juntos#${c.id}`}
                variant={c.id === 'individual' ? 'primary' : 'ghost'}
                event="cta_camino"
                place={`home-caminos-${c.id}`}
              >
                Ver detalle
              </Button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
