---
/**
 * Pizarra de futsal (40×20 m → 400×200) con una acción anotada.
 * Las anotaciones se dibujan al entrar en pantalla (clase .draw + data-reveal).
 * Es un recurso gráfico propio: no depende de fotos de stock.
 */
interface Props {
  class?: string;
  caption?: string;
}
const { class: className, caption = 'Transición defensiva · Fuera de sistema' } = Astro.props;

// Equipo que ataca (sólidos) y que defiende (contorno). Coordenadas en metros ×10.
const attack = [
  { x: 40, y: 100 },  // arquero
  { x: 175, y: 60 },
  { x: 205, y: 140 },
  { x: 255, y: 92 },
  { x: 318, y: 150 },
];
const defend = [
  { x: 372, y: 100 }, // arquero
  { x: 262, y: 128 },
  { x: 300, y: 70 },
  { x: 228, y: 104 },
  { x: 332, y: 120 },
];
---

<figure class:list={['frame relative border border-line bg-panel', className]} data-reveal>
  <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
    <span class="tag flex items-center gap-2 text-mute">
      <span class="size-1.5 rounded-full bg-signal" aria-hidden="true"></span>
      REC · Análisis
    </span>
    <span class="tag text-faint">12:43 / 40:00</span>
  </div>

  <svg viewBox="0 0 400 200" class="block w-full" role="img" aria-labelledby="board-title">
    <title id="board-title">Pizarra de futsal con una acción anotada: pase interior hacia el espacio que deja la defensa</title>

    <!-- Cancha -->
    <g fill="none" stroke="var(--color-line-strong)" stroke-width="1">
      <rect x="4" y="4" width="392" height="192" />
      <line x1="200" y1="4" x2="200" y2="196" />
      <circle cx="200" cy="100" r="30" />
      <path d="M4 40 A 60 60 0 0 1 64 100 A 60 60 0 0 1 4 160" transform="translate(0 0)" />
      <path d="M396 40 A 60 60 0 0 0 336 100 A 60 60 0 0 0 396 160" />
      <rect x="0" y="85" width="4" height="30" />
      <rect x="396" y="85" width="4" height="30" />
    </g>
    <circle cx="200" cy="100" r="1.5" fill="var(--color-line-strong)" />

    <!-- Zona libre -->
    <g class="reveal" style="--d:1.1s">
      <rect x="262" y="72" width="54" height="46" fill="var(--color-signal-dim)" stroke="var(--color-signal)" stroke-width="1" stroke-dasharray="3 3" />
      <text x="274" y="130" font-family="var(--font-mono)" letter-spacing="1" fill="var(--color-signal)" font-size="8">ESPACIO</text>
    </g>

    <!-- Anotaciones que se dibujan -->
    <g class="draw" fill="none" stroke="var(--color-signal)" stroke-width="1.6" stroke-linecap="round">
      <!-- pase -->
      <line x1="175" y1="60" x2="252" y2="90" stroke-dasharray="4 4" style="--len:90;--d:.3s" />
      <!-- desmarque -->
      <path d="M205 140 C 235 150, 262 128, 290 100" style="--len:140;--d:.7s" />
      <polyline points="283,97 290,100 287,107" style="--len:20;--d:1.4s" />
    </g>

    <!-- Jugadores -->
    {defend.map((p) => <circle cx={p.x} cy={p.y} r="6" fill="var(--color-ink)" stroke="var(--color-mute)" stroke-width="1.5" />)}
    {attack.map((p) => <circle cx={p.x} cy={p.y} r="6" fill="var(--color-bone)" />)}
    <circle cx="178" cy="54" r="3" fill="var(--color-signal)" />
  </svg>

  <!-- Línea de tiempo con marcas de codificación -->
  <div class="border-t border-line px-4 py-3">
    <div class="relative h-1 bg-line" aria-hidden="true">
      <div class="absolute inset-y-0 left-0 w-[32%] bg-mute"></div>
      <span class="absolute -top-1 h-3 w-0.5 bg-signal" style="left:12%"></span>
      <span class="absolute -top-1 h-3 w-0.5 bg-signal" style="left:32%"></span>
      <span class="absolute -top-1 h-3 w-0.5 bg-signal" style="left:47%"></span>
      <span class="absolute -top-1 h-3 w-0.5 bg-signal" style="left:71%"></span>
      <span class="absolute -top-1 h-3 w-0.5 bg-signal" style="left:88%"></span>
    </div>
    <figcaption class="tag mt-3 text-faint">{caption}</figcaption>
  </div>
</figure>
