---
import Button from '@/components/ui/Button.astro';
import { cta, method } from '@/data/site';
import { pricing, session } from '@/data/mentoria';

const usd = (n: number) => `${pricing.currency} ${n.toLocaleString('es-AR')}`;
const hasFounders = pricing.founders.spots > 0;
---

<section id="ayuda" class="border-b border-line py-14 md:py-28" aria-labelledby="ayuda-title">
  <div class="page">
    <header class="mb-12 max-w-2xl" data-reveal>
      <h2 id="ayuda-title" class="display reveal text-[2.5rem] text-bone sm:text-5xl md:text-6xl">Cómo puedo ayudarte</h2>
      <p class="reveal mt-4 text-lg leading-relaxed text-mute" style="--d:.08s">Empezá por donde estés.</p>
    </header>

    <div class="grid gap-8 lg:grid-cols-12" data-reveal>
      <!-- Protagonista: Sistema Propio -->
      <article class="reveal frame flex flex-col border border-line bg-panel p-7 md:p-10 lg:col-span-7">
        <p class="tag text-signal">Mentoría 1:1 · {pricing.weeks} semanas</p>
        <h3 class="display mt-3 text-5xl text-bone md:text-6xl">Sistema Propio</h3>
        <p class="mt-4 max-w-lg text-lg leading-relaxed text-mute">
          Construís tu sistema de análisis sobre tu equipo real, con mi devolución en cada etapa.
        </p>

        <ul class="mt-6 space-y-2.5">
          {
            ['5 entregables hechos con tus partidos', '12 llamadas 1:1 y devolución en video', 'Garantía en las 2 primeras semanas'].map((t) => (
              <li class="flex gap-3 text-bone">
                <span class="mt-2.5 h-px w-3 shrink-0 bg-signal" aria-hidden="true" />
                <span class="leading-relaxed">{t}</span>
              </li>
            ))
          }
        </ul>

        <!-- El método, en una línea -->
        <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-mute">
          {
            method.map((m, i) => (
              <>
                <span class="text-bone">{m.title}</span>
                {i < method.length - 1 && <span class="text-signal" aria-hidden="true">→</span>}
              </>
            ))
          }
        </p>

        <div class="mt-8 flex flex-wrap items-end gap-x-8 gap-y-5 border-t border-line pt-6">
          <div>
            <p class="display text-4xl text-bone">{usd(pricing.full)}</p>
            <p class="mt-1 text-sm text-mute">en {pricing.installments.length} cuotas</p>
          </div>
          {
            hasFounders && (
              <p class="max-w-[16rem] text-sm leading-relaxed text-mute">
                <span class="tag mr-1 text-signal">Cohorte fundadora</span>
                {usd(pricing.founders.price)} para los primeros {pricing.founders.spots}.
              </p>
            )
          }
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button href={cta.aplicar.href} event={cta.aplicar.event} place="home-ayuda">{cta.aplicar.label}</Button>
          <Button href={cta.mentoria.href} variant="text" event={cta.mentoria.event} place="home-ayuda">Ver el programa completo</Button>
        </div>
        <p class="mt-5 text-sm leading-relaxed text-faint">
          ¿Dudás? Empezá con una <a href="/trabajar-juntos#individual" class="text-mute underline underline-offset-4 hover:text-signal" data-umami-event="cta_sesion_home">sesión 1:1 de {usd(session.price)}</a>:
          si entrás a la mentoría, se descuenta.
        </p>
      </article>

      <!-- Otras dos puertas, más chicas -->
      <div class="flex flex-col gap-8 lg:col-span-5">
        <article class="reveal border border-line p-7 md:p-8" style="--d:.08s">
          <p class="tag text-signal">Gratis</p>
          <h3 class="mt-3 text-2xl font-semibold text-bone">Empezá sin pagar</h3>
          <p class="mt-2 leading-relaxed text-mute">Un diagnóstico de 3 minutos, cuatro plantillas de trabajo y el análisis de tu clip.</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
            <Button href={cta.diagnostico.href} variant="ghost" event={cta.diagnostico.event} place="home-ayuda">Diagnóstico</Button>
            <Button href="/plantillas" variant="text" event="cta_plantillas" place="home-ayuda">Plantillas</Button>
          </div>
        </article>

        <article class="reveal border border-line p-7 md:p-8" style="--d:.14s">
          <p class="tag text-signal">Clubes y agencias</p>
          <h3 class="mt-3 text-2xl font-semibold text-bone">Un analista en tu cuerpo técnico</h3>
          <p class="mt-2 leading-relaxed text-mute">Informes de rival, acompañamiento durante la temporada y herramientas a medida.</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
            <Button href="/equipos" variant="ghost" event="cta_equipos" place="home-ayuda">Contame qué necesitás</Button>
            <Button href="/trabajar-juntos#equipos" variant="text" event="cta_trabajar" place="home-ayuda">Ver servicios</Button>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
