---
import Button from '@/components/ui/Button.astro';
import { cta } from '@/data/site';
---

<section class="relative overflow-hidden border-b border-line" aria-labelledby="hero-title">
  <div class="court-grid pointer-events-none absolute inset-0 opacity-30" aria-hidden="true"></div>

  <div class="page relative grid gap-10 pt-14 md:pt-20 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7 lg:pb-24 lg:pt-6" data-reveal>
      <p class="tag reveal text-mute">Pablo Granados · Analista de fútbol y futsal</p>

      <h1 id="hero-title" class="display reveal mt-6 text-[3.6rem] text-bone sm:text-8xl lg:text-[5.5rem] xl:text-[6.5rem]" style="--d:.06s">
        Del partido<br />a la <span class="text-signal">decisión.</span>
      </h1>

      <p class="reveal mt-7 max-w-xl text-lg leading-relaxed text-mute md:text-xl" style="--d:.14s">
        Analizo el juego, construyo las herramientas y enseño el proceso a entrenadores y analistas.
      </p>

      <div class="reveal mt-10 flex flex-wrap items-center gap-x-5 gap-y-4" style="--d:.22s">
        <Button href={cta.diagnostico.href} event={cta.diagnostico.event} place="hero">Hacer el diagnóstico gratis</Button>
        <Button href={cta.mentoria.href} variant="ghost" event={cta.mentoria.event} place="hero">Ver Sistema Propio</Button>
      </div>
      <p class="reveal mt-4 text-sm text-faint" style="--d:.28s">El diagnóstico dura 3 minutos y te devuelve tu perfil de analista.</p>
    </div>

    <!-- Foto propia: se funde con el fondo por abajo y por la izquierda -->
    <figure class="relative -mx-4 self-end sm:mx-0 lg:col-span-5">
      <img
        src="/media/hero-pizarra.jpg"
        alt="Pablo Granados con una pizarra táctica de futsal durante un partido"
        width="1398"
        height="1365"
        class="aspect-[5/4] w-full object-cover object-[60%_30%] lg:aspect-[4/5]"
        fetchpriority="high"
        decoding="async"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-transparent to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink via-transparent to-transparent max-lg:hidden" aria-hidden="true"></div>
    </figure>
  </div>
</section>
