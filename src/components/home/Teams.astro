---
import Button from '@/components/ui/Button.astro';
import { chapters } from '@/data/ofertas';

const equipos = chapters.find((c) => c.id === 'equipos')!;
---

<section id="equipos" class="border-y border-line bg-panel py-20 md:py-28" aria-labelledby="equipos-title">
  <div class="page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <header class="lg:col-span-4" data-reveal>
      <p class="tag reveal mb-4 text-signal">Para clubes y agencias</p>
      <h2 id="equipos-title" class="display reveal text-[2.5rem] text-bone sm:text-5xl md:text-6xl" style="--d:.08s">
        Un analista en tu cuerpo técnico
      </h2>
      <p class="reveal mt-5 text-lg leading-relaxed text-mute" style="--d:.16s">
        Trabajo a distancia con equipos de Argentina y del exterior. Parto de una pregunta concreta del cuerpo técnico
        y entrego algo que se usa el domingo, no un archivo más.
      </p>
      <div class="reveal mt-8" style="--d:.24s">
        <Button href="/equipos" event="cta_equipos" place="home-equipos">Contame qué necesitás</Button>
      </div>
    </header>

    <ul class="border-b border-line lg:col-span-8" data-reveal>
      {
        equipos.offers.map((o, i) => (
          <li class="reveal grid gap-4 border-t border-line py-7 md:grid-cols-12 md:gap-8" style={`--d:${i * 0.08}s`}>
            <div class="md:col-span-8">
              <h3 class="text-2xl font-semibold text-bone">{o.name}</h3>
              <p class="mt-2 leading-relaxed text-mute">{o.summary}</p>
            </div>
            <div class="flex items-start justify-between gap-4 md:col-span-4 md:flex-col md:items-end">
              <p class="font-mono text-sm text-signal">{o.price}</p>
              <Button href={o.cta.href} variant="text" event={o.cta.event} place="home-equipos">Consultar</Button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
