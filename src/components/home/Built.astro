---
import Media from '@/components/ui/Media.astro';
import Button from '@/components/ui/Button.astro';
import { projects } from '@/data/site';
import { findCase } from '@/data/casos';
---

<section id="proyectos" class="py-14 md:py-28" aria-labelledby="construi-title">
  <div class="page">
    <header class="mb-12 max-w-2xl" data-reveal>
      <h2 id="construi-title" class="display reveal text-[2.5rem] text-bone sm:text-5xl md:text-6xl">Lo que construí</h2>
      <p class="reveal mt-4 text-lg leading-relaxed text-mute" style="--d:.08s">
        Herramientas reales, que la gente usa todas las semanas.
      </p>
    </header>

    <div class="grid gap-10 md:grid-cols-2 md:gap-8" data-reveal>
      {
        projects.map((p, i) => (
          <article class="reveal flex flex-col" style={`--d:${i * 0.1}s`} aria-labelledby={`p-${p.slug}`}>
            <a
              href={findCase(p.slug) ? p.href : p.external}
              class="group block"
              aria-label={`${p.name}: ${findCase(p.slug) ? 'leer el caso' : p.externalLabel}`}
              data-umami-event={`caso_${p.slug}`}
              data-umami-event-ubicacion="home-imagen"
            >
              <Media
                label={p.media.label}
                src={p.media.src}
                class="transition-[border-color,translate] duration-300 group-hover:-translate-y-1 group-hover:border-signal"
              />
            </a>

            <p class="tag mt-6 text-signal">{p.kind}</p>
            <h3 id={`p-${p.slug}`} class="display mt-2 text-4xl text-bone md:text-5xl">{p.name}</h3>
            <p class="mt-3 leading-relaxed text-mute">{p.result}</p>

            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
              {findCase(p.slug) && (
                <Button href={p.href} event={`caso_${p.slug}`} place="home">Leer el caso</Button>
              )}
              <Button href={p.external} variant="text" event={`out_${p.slug}`} place="home">{p.externalLabel}</Button>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
