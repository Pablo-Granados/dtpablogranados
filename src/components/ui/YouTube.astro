---
/**
 * Video de YouTube liviano: muestra la miniatura y carga el reproductor
 * solo al hacer clic (un embed normal pesa ~500 KB).
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<lite-yt
  data-id={id}
  data-title={title}
  class="frame relative block aspect-video overflow-hidden border border-line bg-panel"
>
  <button
    type="button"
    class="group absolute inset-0 size-full cursor-pointer"
    aria-label={`Reproducir: ${title}`}
    data-umami-event="video_play"
    data-umami-event-id={id}
  >
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      loading="lazy"
      decoding="async"
      class="size-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
    />
    <span class="absolute left-4 top-4 grid size-12 place-items-center bg-signal text-ink" aria-hidden="true">
      <svg viewBox="0 0 16 16" class="size-4" fill="currentColor"><path d="M4 2.5v11l9-5.5z" /></svg>
    </span>
  </button>
</lite-yt>

<script>
  class LiteYt extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1&rel=0`;
        iframe.title = this.dataset.title ?? 'Video de YouTube';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 size-full';
        this.replaceChildren(iframe);
      }, { once: true });
    }
  }
  if (!customElements.get('lite-yt')) customElements.define('lite-yt', LiteYt);
</script>
