---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'ghost' | 'text';
  /** Nombre del evento de Umami. Se registra solo con data-attribute, sin JS propio. */
  event?: string;
  /** Dónde está el botón (hero, mentoria, footer…), para comparar ubicaciones. */
  place?: string;
}

const { href, variant = 'primary', event, place, class: className, ...rest } = Astro.props;
const external = /^https?:\/\//.test(href);

const styles = {
  primary:
    'bg-signal text-ink hover:bg-bone px-5 py-3 font-semibold',
  ghost:
    'border border-line-strong text-bone hover:border-signal hover:text-signal px-5 py-3 font-medium',
  text:
    'text-bone underline decoration-line-strong underline-offset-[6px] hover:decoration-signal hover:text-signal font-medium',
};
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2 text-[0.9375rem] transition-colors duration-200',
    styles[variant],
    className,
  ]}
  data-umami-event={event}
  data-umami-event-ubicacion={place}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  {...rest}
>
  <slot />
  <svg
    aria-hidden="true"
    class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
  >
    {external ? <path d="M5 11 11 5M6 5h5v5" /> : <path d="M3 8h10M9 4l4 4-4 4" />}
  </svg>
</a>
