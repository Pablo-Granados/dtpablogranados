# Copiá este archivo como .env y completá los valores. NUNCA subas el .env a git.
# En Vercel: Settings → Environment Variables (Production + Preview). Después de cambiar algo, Redeploy.

# --- Base de datos (proyecto de Supabase de la web) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # secreta: acceso total, solo servidor
SUPABASE_ANON_KEY=              # opcional: clave pública que solo puede insertar (ver supabase/seguridad.sql)

# --- Mails (Gmail con contraseña de aplicación, sin espacios) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Sitio ---
SITE_URL=https://dtpablogranados.vercel.app

# --- Panel /admin ---
ADMIN_EMAIL=                    # opcional: mail del usuario de Supabase si es distinto de GMAIL_USER
RATE_SALT=                      # opcional: texto cualquiera para anonimizar las IP del freno de abusos

# --- Cal.com ---
PUBLIC_CAL_LINK=                # usuario/evento para quienes aplican (ej. pablo/llamada-sistema-propio)
PUBLIC_CAL_MENTORIA_LINK=       # usuario/evento para las llamadas de mentoría (ej. pablo/mentoria-45)
CAL_WEBHOOK_SECRET=             # secreto del webhook de Cal.com (secreta)

# --- Analytics y contador de Futsal Hub (otro proyecto de Supabase) ---
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
